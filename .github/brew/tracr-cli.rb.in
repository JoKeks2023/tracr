class TracrCli < Formula
  desc "Local development diary and time ledger (command line)"
  homepage "https://github.com/JoKeks2023/tracr"
  version "@VERSION@"
  url "https://github.com/JoKeks2023/tracr/releases/download/v@VERSION@/tracr-@VERSION@-aarch64-apple-darwin.tar.gz"
  sha256 "@SHA256@"

  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "tracr"
  end

  test do
    assert_match "tracr", shell_output("#{bin}/tracr --version")
  end
end

# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                tracr
version             0.12.0
revision            0
categories          sysutils
license             AGPL-3+
platforms           {darwin >= 21}
supported_archs     arm64 x86_64
maintainers         nomaintainer
description         local-first time tracking from AI coding sessions (command line tool)
long_description    tracr reads the local session files of AI coding tools and keeps a \
                    private ledger of the time spent. This port installs the prebuilt, \
                    universal command line tool from the official release; nothing is \
                    compiled on your machine. The desktop app is not part of this port.
homepage            https://tracr.jorisconrad.com

# Prebuilt binary from the GitHub release. The archive holds one directory with
# the universal (arm64 + x86_64) `tracr` executable.
master_sites        https://github.com/JoKeks2023/tracr/releases/download/v${version}/
distname            ${name}-${version}-universal-apple-darwin
use_configure       no
universal_variant   no

checksums           rmd160  9d64f4fd6c04be5a849c526e575cb3175ffed744 \
                    sha256  27fcb5867cd166d2e4b71bb2e898df6d13a342da2a5a245454a6a29bc9c46b6c \
                    size    6265714

extract.suffix      .tar.gz

build {}

destroot {
    xinstall -m 755 ${worksrcpath}/tracr ${destroot}${prefix}/bin/tracr
}

livecheck.type      regex
livecheck.url       https://github.com/JoKeks2023/tracr/releases
livecheck.regex     /releases/tag/v(\[0-9.\]+)
